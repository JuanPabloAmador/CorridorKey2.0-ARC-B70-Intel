#!/usr/bin/env bash
# ck2 — forma sencilla de correr CorridorKey 2.0 en Docker (Intel Arc XPU).
# Uso: ./ck2 <input> <output> [args de infer.py...]
#   <input>:  fichero en ./clips (p. ej. mi.mp4) o ruta absoluta del host.
#   <output>: subcarpeta de ./outputs (p. ej. p1) o ruta absoluta del host.
# Ejemplo:
#   ./ck2 mi.mp4 p1
#   ./ck2 mi.mp4 p1-hint --hint_first_frame /work/in/hint.png --hint_quality 0.95
set -euo pipefail
cd "$(dirname "$0")"
# Crear E/S como el usuario ANTES de que compose los autocree como root.
mkdir -p clips outputs

usage() {
  echo "Uso: ./ck2 <input> <output> [args de infer.py...]" >&2
  echo "  ./ck2 --help  -> ayuda de infer.py" >&2
  exit "${1:-1}"
}

# Paso directo: ./ck2 --help, ./ck2 --cualquier-flag...
if [ $# -eq 0 ]; then usage; fi
if [[ "$1" == -* ]]; then
  exec docker compose run --rm ck2 "$@"
fi
[ $# -ge 2 ] || usage
INPUT="$1"; OUTPUT="$2"; shift 2

# Receta de producción B70 (se respeta lo que el usuario pase explícito).
ARGS=()
i=0
DEF=(--device xpu --hann_chunk 48 --hann_stride 24 --outputs alpha fg --no_carry_hint)
while [ $i -lt ${#DEF[@]} ]; do
  flag="${DEF[$i]}"
  if [[ " $* " == *" $flag "* ]]; then
    i=$((i+2)); continue
  fi
  # flag booleano (--no_carry_hint) no consume valor
  if [ "$flag" = "--no_carry_hint" ] || [ "$flag" = "--outputs" ]; then
    ARGS+=("$flag" "${DEF[$((i+1))]}"); i=$((i+2))
  else
    ARGS+=("$flag" "${DEF[$((i+1))]}"); i=$((i+2))
  fi
done
ARGS+=("$@")

# E/S: ./clips y ./outputs por defecto; rutas absolutas via /work/host*.
EXTRA_VOL=()
if [[ "$INPUT" = /* ]]; then
  EXTRA_VOL+=(-v "$(dirname "$INPUT"):/work/host-in:ro")
  IN_ARG="/work/host-in/$(basename "$INPUT")"
else
  IN_ARG="/work/in/$INPUT"
fi
if [[ "$OUTPUT" = /* ]]; then
  mkdir -p "$OUTPUT"
  EXTRA_VOL+=(-v "$OUTPUT:/work/host-out")
  OUT_ARG="/work/host-out"
else
  mkdir -p "outputs/$OUTPUT"
  OUT_ARG="/work/out/$OUTPUT"
fi

export TARGET_UID="$(id -u)" TARGET_GID="$(id -g)"
export RENDER_GID="$(getent group render | cut -d: -f3 || true)"
export DRI_DEVICE="${DRI_DEVICE:-/dev/dri/renderD128}"
[ -e "$DRI_DEVICE" ] || { echo "ERROR: no existe $DRI_DEVICE (¿GPU Intel visible?)." >&2; exit 1; }

# shellcheck disable=SC2086
exec docker compose run --rm ${EXTRA_VOL[@]+"${EXTRA_VOL[@]}"} ck2 \
  --input "$IN_ARG" --output_dir "$OUT_ARG" "${ARGS[@]}"
