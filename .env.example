# Copia a `.env` y ajusta. El wrapper ./ck2 calcula UID/GID/RENDER solo;
# este fichero es para uso avanzado (docker compose run directo).

# Usuario dueño de los ficheros generados (por defecto: quien ejecuta).
TARGET_UID=1000
TARGET_GID=1000
# Grupo con acceso a /dev/dri (getent group render). Vacío = sin grupo extra.
RENDER_GID=
# Device DRI de la Intel Arc en el host.
DRI_DEVICE=/dev/dri/renderD128

# Carpetas de E/S (se montan en /work/in:ro y /work/out).
CK2_INPUT_DIR=./clips
CK2_OUTPUT_DIR=./outputs

# Nombre del contenedor efímero.
CK2_CONTAINER=corridorkey2-b70
# Token de HuggingFace (solo si algún peso lo exige). Nunca commitear el .env.
HF_TOKEN=
# CK2_SKIP_DOWNLOAD=1 para fallar si faltan pesos en vez de descargarlos.
CK2_SKIP_DOWNLOAD=0
