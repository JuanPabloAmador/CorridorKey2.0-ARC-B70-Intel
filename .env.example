# Copy to `.env` and adjust. The ./corridorkey-docker wrapper computes
# UID/GID/RENDER on its own; this file is for advanced use
# (direct `docker compose run`).

# Owner of generated files (defaults to whoever runs it).
TARGET_UID=1000
TARGET_GID=1000
# Group with /dev/dri access (getent group render). Empty = no extra group.
RENDER_GID=
# DRI device of the Intel Arc on the host. Empty = auto-detect the Intel
# render node (override only with several Intel GPUs).
DRI_DEVICE=

# I/O folders (mounted at /work/in:ro and /work/out).
CK2_INPUT_DIR=./clips
CK2_OUTPUT_DIR=./outputs

# Name of the ephemeral container.
CK2_CONTAINER=corridorkey2-b70
# HuggingFace token (only if some weights require it). Never commit .env.
HF_TOKEN=
# CK2_SKIP_DOWNLOAD=1 to fail on missing weights instead of downloading them.
CK2_SKIP_DOWNLOAD=0
