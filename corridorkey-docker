#!/usr/bin/env bash
# corridorkey-docker — easy way to run CorridorKey 2.0 in Docker (Intel Arc XPU).
# Usage: ./corridorkey-docker <input> <output> [infer.py args...]
#   <input>:  file in ./clips (e.g. my-clip.mp4) or absolute host path.
#   <output>: subfolder of ./outputs (e.g. my-first-run) or absolute host path.
# Example:
#   ./corridorkey-docker my-clip.mp4 my-first-run
#   ./corridorkey-docker my-clip.mp4 with-hint --hint_first_frame /work/in/hint.png --hint_quality 0.95
set -euo pipefail
cd "$(dirname "$0")"
# Create I/O dirs as the user BEFORE compose auto-creates them as root.
mkdir -p clips outputs

usage() {
  echo "Usage: ./corridorkey-docker <input> <output> [infer.py args...]" >&2
  echo "  ./corridorkey-docker --help  -> infer.py help" >&2
  exit "${1:-1}"
}

# Passthrough: ./corridorkey-docker --help, ./corridorkey-docker --any-flag...
if [ $# -eq 0 ]; then usage; fi
if [[ "$1" == -* ]]; then
  exec docker compose run --rm --build corridorkey "$@"
fi
[ $# -ge 2 ] || usage
INPUT="$1"; OUTPUT="$2"; shift 2

# Stable B70 recipe (any flag passed explicitly wins).
ARGS=()
[[ " $* " == *" --device "* ]] || ARGS+=(--device xpu)
[[ " $* " == *" --hann_chunk "* ]] || ARGS+=(--hann_chunk 48)
[[ " $* " == *" --hann_stride "* ]] || ARGS+=(--hann_stride 24)
[[ " $* " == *" --outputs "* ]] || ARGS+=(--outputs alpha fg)
[[ " $* " == *" --no_carry_hint "* ]] || ARGS+=(--no_carry_hint)
ARGS+=("$@")

# I/O: ./clips and ./outputs by default; special cases via /work/job/<ctx>
# (never nested under the read-only /work/in: docker cannot create nested
# mountpoints there). The container path never ends in a generic name
# (input/frames/rgb): those make infer.py fall back to the folder name
# (upstream rule). Generic names get a descriptive alias from the folder,
# so outputs are always named after the clip. Extra files next to a
# remapped input resolve under the same /work/job/<ctx>/ dir.
GENERIC_NAMES="input frames rgb"
lower_noext() { # lowercased basename without extension
  local b; b="$(basename "$1")"; b="${b%.*}"
  echo "$b" | tr '[:upper:]' '[:lower:]'
}
is_generic() {
  local n; n="$(lower_noext "$1")"
  local g; for g in $GENERIC_NAMES; do [ "$n" = "$g" ] && return 0; done
  return 1
}
INPUT="${INPUT%/}" # no trailing slash (frame dirs)
INPUT="${INPUT#./}" # no leading ./ (it breaks alias building)
EXTRA_VOL=()
if [[ "$INPUT" = /* ]]; then
  CTX="$(dirname "$INPUT")"; CTXBASE="$(basename "$CTX")"
  [ -n "$CTXBASE" ] || CTXBASE="root"
  if is_generic "$CTXBASE"; then CTXBASE="job"; fi # /input/input.mp4 etc.
  EXTRA_VOL+=(-v "$CTX:/work/job/$CTXBASE:ro")
  IN_ARG="/work/job/$CTXBASE/$(basename "$INPUT")"
else
  SRCDIR="$(dirname "clips/$INPUT")" # clips | clips/sub | .
  JOBDIR="$(echo "$SRCDIR" | tr '/' '-')"
  if is_generic "$INPUT"; then
    # clips/input.mp4 -> /work/job/clips/input.mp4 (stem: clips)
    EXTRA_VOL+=(-v "$(pwd)/$SRCDIR:/work/job/$JOBDIR:ro")
    IN_ARG="/work/job/$JOBDIR/$(basename "$INPUT")"
  else
    IN_ARG="/work/in/$INPUT"
  fi
fi
if [[ "$OUTPUT" = /* ]]; then
  mkdir -p "$OUTPUT"
  EXTRA_VOL+=(-v "$OUTPUT:/work/host-out")
  OUT_ARG="/work/host-out"
else
  mkdir -p "outputs/$OUTPUT"
  OUT_ARG="/work/out/$OUTPUT"
fi

export TARGET_UID="$(id -u)" TARGET_GID="$(id -g)"
# Group owning /dev/dri (usually render, video on some distros).
export RENDER_GID="$(getent group render | cut -d: -f3 || true)"
[ -n "$RENDER_GID" ] || RENDER_GID="$(getent group video | cut -d: -f3 || true)"

# Find the Intel render node (vendor 0x8086); DRI_DEVICE overrides the guess.
detect_intel_render() {
  for d in /dev/dri/renderD*; do
    [ -e "$d" ] || continue
    if [ "$(cat "/sys/class/drm/$(basename "$d")/device/vendor" 2>/dev/null)" = "0x8086" ]; then
      echo "$d"
      return 0
    fi
  done
  return 1
}
if [ -z "${DRI_DEVICE:-}" ]; then
  DRI_DEVICE="$(detect_intel_render || true)"
fi
if [ -z "$DRI_DEVICE" ]; then
  echo "ERROR: no Intel GPU render node under /dev/dri." >&2
  echo "The host needs an Intel GPU driver with support for your card" >&2
  echo "(Battlemage needs Ubuntu 26.04 or newer out of the box):" >&2
  echo "https://dgpu-docs.intel.com/installation-guides/index.html" >&2
  exit 1
fi
[ -e "$DRI_DEVICE" ] || { echo "ERROR: $DRI_DEVICE not found." >&2; exit 1; }
export DRI_DEVICE

# shellcheck disable=SC2086
exec docker compose run --rm --build ${EXTRA_VOL[@]+"${EXTRA_VOL[@]}"} corridorkey \
  --input "$IN_ARG" --output_dir "$OUT_ARG" "${ARGS[@]}"
